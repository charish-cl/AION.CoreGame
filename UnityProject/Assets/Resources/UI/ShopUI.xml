                            <!-- 商品描述 -->
                            <Text Name="Product4Desc" X="0" Y="-10" Width="280" Height="30"
                                  text="恢复道具"
                                  fontSize="16"
                                  color="#FF666666"
                                  alignment="MiddleCenter"/>

                            <!-- 价格 -->
                            <Panel Name="Product4PricePanel" X="0" Y="40" Width="280" Height="50" Anchor="BottomCenter">
                                <Image Name="Price4Icon" X="0" Y="0" Width="30" Height="30" Anchor="MiddleLeft" sprite=""/>
                                <Text Name="Product4Price" X="40" Y="0" Width="240" Height="50"
                                      text="500"
                                      fontSize="24"
                                      color="#FFD700"
                                      alignment="MiddleLeft"/>
                            </Panel>
                        </Panel>
                    </Panel>

                    <!-- 第五个商品 -->
                    <Panel Name="Product5">
                        <!-- 商品图片 -->
                        <Image Name="Product5Image" X="0" Y="-100" Width="300" Height="280" Anchor="TopCenter" sprite=""/>

                        <!-- 商品信息背景 -->
                        <Panel Name="Product5Info" X="0" Y="100" Width="300" Height="150" Anchor="BottomCenter" color="#FFFFFFFF">
                            <!-- 商品名称 -->
                            <Text Name="Product5Name" X="0" Y="-50" Width="280" Height="40"
                                  text="强化石"
                                  fontSize="22"
                                  color="#FF333333"
