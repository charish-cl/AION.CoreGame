                        <!-- 商品图片 -->
                        <Image Name="Product3Image" X="0" Y="-100" Width="300" Height="280" Anchor="TopCenter" sprite=""/>

                        <!-- 商品信息背景 -->
                        <Panel Name="Product3Info" X="0" Y="100" Width="300" Height="150" Anchor="BottomCenter" color="#FFFFFFFF">
                            <!-- 商品名称 -->
                            <Text Name="Product3Name" X="0" Y="-50" Width="280" Height="40"
                                  text="神秘道具"
                                  fontSize="22"
                                  color="#FF333333"
