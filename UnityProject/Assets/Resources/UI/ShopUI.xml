                            <!-- 商品描述 -->
                            <Text Name="Product3Desc" X="0" Y="-10" Width="280" Height="30"
                                  text="特殊物品"
                                  fontSize="16"
                                  color="#FF666666"
                                  alignment="MiddleCenter"/>

                            <!-- 价格 -->
                            <Panel Name="Product3PricePanel" X="0" Y="40" Width="280" Height="50" Anchor="BottomCenter">
                                <Image Name="Price3Icon" X="0" Y="0" Width="30" Height="30" Anchor="MiddleLeft" sprite=""/>
                                <Text Name="Product3Price" X="40" Y="0" Width="240" Height="50"
                                      text="800"
                                      fontSize="24"
                                      color="#FFD700"
                                      alignment="MiddleLeft"/>
                            </Panel>
                        </Panel>
                    </Panel>

                    <!-- 第四个商品 -->
                    <Panel Name="Product4">
                        <!-- 商品图片 -->
                        <Image Name="Product4Image" X="0" Y="-100" Width="300" Height="280" Anchor="TopCenter" sprite=""/>

