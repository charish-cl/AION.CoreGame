                            <!-- 价格 -->
                            <Panel Name="Product5PricePanel" X="0" Y="40" Width="280" Height="50" Anchor="BottomCenter">
                                <Image Name="Price5Icon" X="0" Y="0" Width="30" Height="30" Anchor="MiddleLeft" sprite=""/>
                                <Text Name="Product5Price" X="40" Y="0" Width="240" Height="50"
