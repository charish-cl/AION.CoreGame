                                      color="#FFD700"
                                      alignment="MiddleLeft"/>
                            </Panel>
                        </Panel>
                    </Panel>

                    <!-- 第六个商品 -->
                    <Panel Name="Product6">
                        <!-- 商品图片 -->
                        <Image Name="Product6Image" X="0" Y="-100" Width="300" Height="280" Anchor="TopCenter" sprite=""/>

                        <!-- 商品信息背景 -->
                        <Panel Name="Product6Info" X="0" Y="100" Width="300" Height="150" Anchor="BottomCenter" color="#FFFFFFFF">
                            <!-- 商品名称 -->
                            <Text Name="Product6Name" X="0" Y="-50" Width="280" Height="40"
                                  text="经验卷轴"
                                  fontSize="22"
                                  color="#FF333333"
                                  alignment="MiddleCenter"/>

                            <!-- 商品描述 -->
                            <Text Name="Product6Desc" X="0" Y="-10" Width="280" Height="30"
                                  text="经验加成"
                                  fontSize="16"
                                  color="#FF666666"
                                  alignment="MiddleCenter"/>

                            <!-- 价格 -->
                            <Panel Name="Product6PricePanel" X="0" Y="40" Width="280" Height="50" Anchor="BottomCenter">
                                <Image Name="Price6Icon" X="0" Y="0" Width="30" Height="30" Anchor="MiddleLeft" sprite=""/>
                                <Text Name="Product6Price" X="40" Y="0" Width="240" Height="50"
                                      text="150"
                                      fontSize="24"
                                      color="#FFD700"
                                      alignment="MiddleLeft"/>
                            </Panel>
                        </Panel>
                    </Panel>
                </Grid>
            </Panel>
        </ScrollRect>

        <!-- 底部导航栏 -->
        <Panel Name="BottomNav" X="0" Y="520" Width="750" Height="120" Anchor="BottomCenter" color="#FF2C2C2C">
            <!-- 商店按钮 - 选中状态 -->
            <Button Name="ShopButton" X="-300" Y="0" Width="120" Height="100" Anchor="MiddleLeft">
                <Image Name="ShopIcon" X="0" Y="20" Width="60" Height="60" Anchor="TopCenter" sprite=""/>
                <Text Name="ShopText" X="0" Y="-30" Width="120" Height="30"
                      text="商店"
                      fontSize="18"
                      color="#FFD700"
                      alignment="MiddleCenter"/>
            </Button>

            <!-- 皮肤按钮 -->
            <Button Name="SkinButton" X="-150" Y="0" Width="120" Height="100" Anchor="MiddleLeft">
                <Image Name="SkinIcon" X="0" Y="20" Width="60" Height="60" Anchor="TopCenter" sprite=""/>
                <Text Name="SkinText" X="0" Y="-30" Width="120" Height="30"
                      text="皮肤"
                      fontSize="18"
                      color="#FFFFFFFF"
                      alignment="MiddleCenter"/>
            </Button>

            <!-- 设施按钮 -->
            <Button Name="FacilityButton" X="0" Y="0" Width="120" Height="100" Anchor="MiddleCenter">
                <Image Name="FacilityIcon" X="0" Y="20" Width="60" Height="60" Anchor="TopCenter" sprite=""/>
                <Text Name="FacilityText" X="0" Y="-30" Width="120" Height="30"
                      text="设施"
                      fontSize="18"
                      color="#FFFFFFFF"
                      alignment="MiddleCenter"/>
            </Button>

            <!-- 战斗按钮 -->
            <Button Name="BattleButton" X="150" Y="0" Width="120" Height="100" Anchor="MiddleRight">
                <Image Name="BattleIcon" X="0" Y="20" Width="60" Height="60" Anchor="TopCenter" sprite=""/>
                <Text Name="BattleText" X="0" Y="-30" Width="120" Height="30"
                      text="战斗"
                      fontSize="18"
                      color="#FFFFFFFF"
                      alignment="MiddleCenter"/>
            </Button>

            <!-- 国王按钮 -->
            <Button Name="KingButton" X="300" Y="0" Width="120" Height="100" Anchor="MiddleRight">
                <Image Name="KingIcon" X="0" Y="20" Width="60" Height="60" Anchor="TopCenter" sprite=""/>
                <Text Name="KingText" X="0" Y="-30" Width="120" Height="30"
                      text="国王"
                      fontSize="18"
                      color="#FFFFFFFF"
                      alignment="MiddleCenter"/>
