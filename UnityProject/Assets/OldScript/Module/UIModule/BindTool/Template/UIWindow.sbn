{{~ 
    # 定义渲染代码列表的函数
    func render_code_list(code_list)
        if code_list.size > 0
            for data in code_list
                # 根据缩进级别生成前缀
                "\n"+data
                #换行
               
            end
        end
    end
~}}
using UnityEngine;
using UnityEngine.UI;
using TMPro;
namespace {{ namespace }}
{
    public partial class {{ class_name }} : UIWindow
    {
        #region 变量
        {{render_code_list(field_codelist)}}
        #endregion

        #region 通用
        {{~if event_list.size > 0  ~}}
        public override void RegisterEvent()
        {
            {{~for event in event_list ~}}
            AddUIEvent({{event.EventClassName}}_Event.{{event.EventMethod}}, RefreshUI);
            {{~end~}}
        }
        {{~end~}}

        public override void OnCreate()
        {
            
        }


        public void RefreshUI()
        {
            {{render_code_list(refresh_ui_codelist)}}
        }
        #endregion

        #region 生成方法
        {{render_code_list(method_codelist)}}
        #endregion
    }
}
