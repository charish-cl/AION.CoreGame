using AION.CoreFramework;
using UnityEngine;
using UnityEngine.UI;
using TMPro;

namespace {{ namespace }}
{
    public partial class {{ class_name }} : {{ derived_class_name }}
    {
        {{~ for item in bind_datas ~}}
        public {{ item.TypeName }} {{ item.propName }} { get; set; }
        {{~ end ~}}

        public override void ScriptGenerator()
        {
            {{~ for item in bind_datas ~}}
            {{~ if item.TypeName == "Button" ~}}
            {{ item.propName }} = transform.Find("{{ item.path }}").GetComponent<Button>();
            {{ item.propName }}.onClick.AddListener(() => OnClick_{{ item.propName }}());
            {{ else if item.TypeName == "GameObject" }}
            {{ item.propName }} = transform.Find("{{ item.path }}").gameObject;
            {{ else if item.TypeName == "TabModule" }}
            {{ item.propName }} = transform.Find("{{ item.path }}").GetComponent<UISetActiveBindTool>().ConvertToTab();
            {{ else }}
            {{ item.propName }} = transform.Find("{{ item.path }}").GetComponent<{{ item.TypeName }}>();
            {{~ end }}
            {{~ end ~}}
        }
    }
}